                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "not": {
                "required": [
                  "resolvedBy"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "open",
                    "resolved"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "not": {
                "required": [
                  "reason"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "resolved"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "oneOf": [
                {
                  "required": [
                    "selected"
                  ],
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "outcome"
                        ]
                      },
                      {
                        "required": [
                          "values"
                        ]
                      },
                      {
                        "required": [
                          "freeText"
                        ]
                      }
                    ]
                  }
                },
                {
                  "required": [
                    "outcome"
                  ],
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "selected"
                        ]
                      },
                      {
                        "required": [
                          "values"
                        ]
                      },
                      {
                        "required": [
                          "freeText"
                        ]
                      }
                    ]
                  }
                },
                {
                  "required": [
                    "values"
                  ],
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "selected"
                        ]
                      },
                      {
                        "required": [
                          "outcome"
                        ]
                      },
                      {
                        "required": [
                          "freeText"
                        ]
                      }
                    ]
                  }
                },
                {
                  "required": [
                    "freeText"
                  ],
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "selected"
                        ]
                      },
                      {
                        "required": [
                          "outcome"
                        ]
                      },
                      {
                        "required": [
                          "values"
                        ]
                      }
                    ]
                  }
                }
              ]
            },
            "else": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "selected"
                    ]
                  },
                  {
                    "required": [
                      "outcome"
                    ]
                  },
                  {
                    "required": [
                      "values"
                    ]
                  },
                  {
                    "required": [
                      "freeText"
                    ]
                  },
                  {
                    "required": [
                      "resolvedAt"
                    ]
                  },
                  {
                    "required": [
                      "resolvedBy"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
