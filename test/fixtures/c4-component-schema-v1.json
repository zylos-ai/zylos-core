        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "resolved"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "resolvedAt"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "cancelled"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "reason"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "cancelled",
                    "expired",
                    "superseded"
