          "time_series",
          "breakdown",
          "category_series",
          "choice",
          "confirmation",
          "form_intent"
        ]
      },
      "schemaVersion": {
        "const": 1
      },
      "data": {
        "type": "object"
      },
      "fallbackText": {
        "type": "string",
        "maxLength": 2000
