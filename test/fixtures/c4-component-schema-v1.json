                    {
                      "required": [
                        "selected"
                      ]
                    },
                    {
                      "required": [
                        "values"
                      ]
                    }
                  ]
                }
              }
            }
          }
        ]
      },
      "formField": {
        "type": "object",
        "required": [
          "key",
          "label",
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "$ref": "#/$defs/key"
          },
          "label": {
            "$ref": "#/$defs/label"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "multiline_text",
              "number",
              "integer",
              "date",
              "datetime",
              "boolean",
              "single_select",
              "multi_select"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "options": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "$ref": "#/$defs/option"
            }
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
