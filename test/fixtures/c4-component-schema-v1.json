          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 10,
            "items": {
              "$ref": "#/$defs/option"
            }
          },
          "selection": {
            "type": "string",
            "enum": [
              "single",
              "multiple"
            ]
          },
          "minSelect": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "maxSelect": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "allowFreeText": {
            "type": "boolean"
          },
          "action": {
            "allOf": [
              {
                "$ref": "action.schema.json#/$defs/actionSpec"
              },
              {
                "properties": {
                  "type": {
                    "const": "choice.select"
                  }
                }
              }
            ]
          },
          "state": {
            "$ref": "#/$defs/blockState"
          }
        },
        "allOf": [
          {
            "properties": {
              "state": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "outcome"
                      ]
                    },
                    {
                      "required": [
                        "values"
                      ]
                    }
                  ]
                }
              }
            }
          }
        ]
      },
      "confirmationData": {
        "type": "object",
        "required": [
          "title",
          "severity",
          "action"
