            "type": "integer",
            "minimum": 1,
            "maximum": 2000
          },
          "unit": {
            "$ref": "#/$defs/unit"
          },
          "placeholder": {
            "$ref": "#/$defs/label"
          },
          "help": {
            "$ref": "#/$defs/text"
          },
          "defaultValue": {
            "anyOf": [
              {
                "$ref": "#/$defs/scalar"
              },
              {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "string",
                  "maxLength": 64
                }
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "enum": [
                    "single_select",
                    "multi_select"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "options"
              ],
              "properties": {
                "options": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      },
      "formIntentData": {
        "type": "object",
        "required": [
          "fields",
          "action"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "$ref": "#/$defs/label"
          },
          "purpose": {
            "$ref": "#/$defs/text"
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "$ref": "#/$defs/formField"
            }
          },
          "submitLabel": {
            "$ref": "#/$defs/shortLabel"
          },
          "action": {
            "allOf": [
              {
                "$ref": "action.schema.json#/$defs/actionSpec"
              },
              {
                "properties": {
                  "type": {
                    "const": "form.submit"
                  }
                }
              }
            ]
          },
          "state": {
            "$ref": "#/$defs/blockState"
          }
        },
        "allOf": [
          {
            "properties": {
              "state": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "selected"
                      ]
                    },
                    {
                      "required": [
                        "outcome"
                      ]
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    }
  },
  "ACTION_SCHEMA": {
    "$defs": {
      "messageId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
      },
      "blockId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
      },
      "optionId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
      },
      "actionId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{7,127}$"
      },
      "actionType": {
        "type": "string",
        "enum": [
          "choice.select",
          "confirmation.respond",
          "form.submit"
        ]
      },
      "target": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){0,3}$",
        "maxLength": 64
      },
      "actionSpec": {
        "type": "object",
        "required": [
          "type",
          "target"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "$ref": "#/$defs/actionType"
          },
          "target": {
            "$ref": "#/$defs/target"
          },
          "requiresConfirmation": {
            "type": "boolean"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "if": {
          "properties": {
            "requiresConfirmation": {
              "const": true
            }
          },
          "required": [
            "requiresConfirmation"
          ]
        },
        "then": {
          "properties": {
            "type": {
              "const": "confirmation.respond"
            }
          }
        }
      },
      "actionContext": {
        "type": "object",
        "required": [
          "messageId",
          "blockId"
        ],
        "additionalProperties": false,
        "properties": {
          "conversationId": {
            "$ref": "#/$defs/messageId"
          },
          "messageId": {
            "$ref": "#/$defs/messageId"
          },
          "blockId": {
            "$ref": "#/$defs/blockId"
          }
        }
      },
      "choiceSelectPayload": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "selected": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/optionId"
            },
            "minItems": 1,
            "maxItems": 10,
            "uniqueItems": true
          },
          "freeText": {
            "$ref": "#/$defs/freeText"
          }
        },
        "oneOf": [
          {
            "required": [
              "selected"
            ]
          },
          {
            "required": [
              "freeText"
            ]
          }
        ]
      },
      "freeText": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "confirmationRespondPayload": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "outcome": {
            "type": "string",
            "enum": [
              "confirm",
              "cancel"
            ]
          },
          "freeText": {
            "$ref": "#/$defs/freeText"
          }
        },
        "oneOf": [
          {
            "required": [
              "outcome"
            ]
          },
          {
            "required": [
              "freeText"
            ]
          }
        ]
      },
      "formSubmitPayload": {
        "type": "object",
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "values"
            ]
          },
          {
            "required": [
              "freeText"
            ]
          }
        ],
        "properties": {
          "freeText": {
            "$ref": "#/$defs/freeText"
          },
          "values": {
            "type": "object",
            "maxProperties": 12,
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9_]{0,31}$"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ],
                  "maxLength": 2000
                },
                {
                  "type": "array",
                  "maxItems": 20,
                  "items": {
                    "type": "string",
                    "maxLength": 64
                  }
                }
              ]
            }
          }
        }
      },
      "actionRequest": {
        "type": "object",
        "required": [
          "id",
          "protocolVersion",
          "type",
          "target",
          "context",
          "payload"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/actionId"
          },
          "protocolVersion": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+$"
          },
          "type": {
            "$ref": "#/$defs/actionType"
          },
          "target": {
            "$ref": "#/$defs/target"
          },
          "context": {
            "$ref": "#/$defs/actionContext"
          },
          "payload": {
            "type": "object"
          },
          "clientTs": {
            "type": "string",
            "format": "date-time"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "choice.select"
                }
              }
            },
            "then": {
              "properties": {
                "payload": {
                  "$ref": "#/$defs/choiceSelectPayload"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "confirmation.respond"
                }
              }
            },
            "then": {
              "properties": {
                "payload": {
                  "$ref": "#/$defs/confirmationRespondPayload"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "form.submit"
                }
              }
            },
            "then": {
              "properties": {
                "payload": {
                  "$ref": "#/$defs/formSubmitPayload"
                }
              }
            }
          }
        ]
      }
    }
  }
}
