          },
          "required": [
            "status"
          ]
        },
        "then": {
          "required": [
            "fallbackText"
          ]
        },
        "else": {
          "required": [
            "data"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "status": {
              "const": "error"
            }
          },
          "required": [
            "status"
          ]
        },
        "else": {
          "not": {
