                }
              },
              "required": [
                "provenance"
              ]
            }
          },
          "required": [
            "metadata"
          ]
        },
        "then": {
          "properties": {
            "type": {
              "const": "markdown"
            }
          }
        }
      }
    ],
    "$defs": {
      "blockId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
      },
      "key": {
