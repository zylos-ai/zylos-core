          "yLabel": {
            "$ref": "#/$defs/label"
          },
          "unit": {
            "$ref": "#/$defs/unit"
          },
          "format": {
            "$ref": "#/$defs/valueFormat"
          },
          "points": {
            "type": "array",
            "minItems": 1,
