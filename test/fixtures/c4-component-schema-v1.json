                "const": "markdown"
              }
            }
          }
        },
        "then": {
          "required": [
            "fallbackText"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "markdown"
            }
          }
        },
        "then": {
          "properties": {
            "data": {
              "$ref": "#/$defs/markdownData"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "time_series"
            }
          }
        },
        "then": {
          "properties": {
            "data": {
              "$ref": "#/$defs/timeSeriesData"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "breakdown"
            }
          }
        },
        "then": {
          "properties": {
            "data": {
              "$ref": "#/$defs/breakdownData"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "category_series"
            }
          }
        },
        "then": {
          "properties": {
            "data": {
              "$ref": "#/$defs/categorySeriesData"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "choice"
