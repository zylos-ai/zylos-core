          }
        },
        "then": {
          "properties": {
            "data": {
              "$ref": "#/$defs/confirmationData"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "form_intent"
            }
          }
        },
        "then": {
          "properties": {
            "data": {
              "$ref": "#/$defs/formIntentData"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "status": {
              "enum": [
