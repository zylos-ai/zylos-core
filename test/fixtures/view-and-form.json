{
  "message": {
    "version": 1,
    "kind": "message",
    "messageId": "combined_message",
    "fallbackText": "Compare both plans, then choose.",
    "blocks": [
      {
        "id": "plan_a",
        "type": "markdown",
        "schemaVersion": 1,
        "data": {
          "text": "Plan A"
        }
      },
      {
        "id": "plan_b",
        "type": "markdown",
        "schemaVersion": 1,
        "data": {
          "text": "Plan B"
        }
      },
      {
        "id": "question",
        "type": "choice",
        "schemaVersion": 1,
        "fallbackText": "Choose a plan",
        "data": {
          "prompt": "Choose a plan",
          "options": [
            {
              "id": "a",
              "label": "A"
            },
            {
              "id": "b",
              "label": "B"
            }
          ],
          "action": {
            "type": "choice.select",
            "target": "clarification.answer"
          }
        }
      }
    ],
    "interruptId": "combined_question",
    "questionSummary": "Choose a plan",
    "interrupt": {
      "blockId": "question",
      "reason": "input_required"
    }
  },
  "formQuestion": {
    "version": 1,
    "kind": "message",
    "messageId": "conditional_form",
    "fallbackText": "Enter customer details.",
    "blocks": [
      {
        "id": "customer_form",
        "type": "form_intent",
        "schemaVersion": 2,
        "fallbackText": "Enter customer details",
        "data": {
          "title": "Customer details",
          "fields": [
            {
              "key": "customer_type",
              "label": "Customer type",
              "type": "single_select",
              "required": true,
              "options": [
                {
                  "id": "person",
                  "label": "Person"
                },
                {
                  "id": "company",
                  "label": "Company"
                },
                {
                  "id": "partner",
                  "label": "Partner"
                }
              ]
            },
            {
              "key": "company_name",
              "label": "Company name",
              "type": "text",
              "required": true,
              "maxLength": 40,
              "activeWhen": {
                "field": "customer_type",
                "eq": "company"
              }
            },
            {
              "key": "employee_count",
              "label": "Employee count",
              "type": "integer",
              "required": true,
              "min": 1,
              "max": 100,
              "activeWhen": {
                "field": "customer_type",
                "eq": "company"
              }
            },
            {
              "key": "tags",
              "label": "Tags",
              "type": "multi_select",
              "options": [
                {
                  "id": "urgent",
                  "label": "Urgent"
                },
                {
                  "id": "vip",
                  "label": "VIP"
                }
              ]
            },
            {
              "key": "tag_note",
              "label": "Tag note",
              "type": "text",
              "maxLength": 20,
              "activeWhen": {
                "field": "tags",
                "present": true
              }
            }
          ],
          "action": {
            "type": "form.submit",
            "target": "customer.register"
          }
        }
      }
    ],
    "interruptId": "customer_interrupt",
    "questionSummary": "Enter customer details",
    "interrupt": {
      "blockId": "customer_form",
      "reason": "input_required"
    }
  },
