# Proves the deployed SQLite driver is the comm-bridge skill's own nested Node 22 native
# better-sqlite3, that scheduler, web-console and dashboard install no copy of their own, and that
# the shared loader they import opens and uses a SQLite DB for each skill with exactly that one driver.
SETUP=init
SCENARIO_CMD=node --input-type=module -e 'import fs from "node:fs";import path from "node:path";import {createRequire} from "node:module";const skills=path.join(process.env.ZYLOS_DIR,".claude","skills");const own=fs.realpathSync(path.join(skills,"comm-bridge","node_modules","better-sqlite3"))+path.sep;const resolved=createRequire(path.join(skills,"comm-bridge","package.json")).resolve("better-sqlite3");if(!resolved.startsWith(own)){console.error(`BAD_RESOLVE comm-bridge ${resolved}`);process.exit(1)}const {default:Database}=await import(path.join(skills,"comm-bridge","scripts","sqlite-driver.js"));for(const skill of ["scheduler","comm-bridge","web-console","dashboard"]){if(skill!=="comm-bridge"&&fs.existsSync(path.join(skills,skill,"node_modules","better-sqlite3"))){console.error(`EXTRA_DRIVER ${skill}`);process.exit(1)}const dbPath=path.join(process.env.ZYLOS_DIR,`${skill}-service-health.db`);try{const db=new Database(dbPath);try{db.exec("CREATE TABLE smoke (id INTEGER PRIMARY KEY, name TEXT NOT NULL)");db.prepare("INSERT INTO smoke (name) VALUES (?)").run(skill);const row=db.prepare("SELECT name FROM smoke WHERE id = 1").get();if(!row||row.name!==skill){console.error(`BAD_CRUD ${skill}`);process.exit(1)}}finally{db.close()}}finally{for(const suffix of ["","-shm","-wal"])try{fs.unlinkSync(dbPath+suffix)}catch{}}console.log(`SERVICE_HEALTH_OK ${skill}`)}const drivers=[...new Set(fs.readFileSync("/proc/self/maps","utf8").split("\n").filter(l=>l.endsWith("/better_sqlite3.node")).map(l=>l.slice(l.indexOf("/"))))];if(drivers.length!==1||!drivers[0].startsWith(own)){console.error(`BAD_DRIVER ${drivers.join(",")}`);process.exit(1)}console.log("SERVICE_HEALTH_OK all")'
EXPECT_EXIT=0
EXPECT_STDOUT=SERVICE_HEALTH_OK all
EXPECT_STDERR=
