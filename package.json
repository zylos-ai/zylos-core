{
  "name": "zylos",
  "version": "0.9.2",
  "type": "module",
  "description": "Autonomous AI Agent Infrastructure",
  "main": "cli/zylos.js",
  "bin": {
    "zylos": "./cli/zylos.js"
  },
  "scripts": {
    "preinstall": "node scripts/preinstall.js",
    "postinstall": "node scripts/postinstall.js || true",
    "pretest": "node scripts/install-skill-deps.js",
    "test": "npm run test:jest && npm run test:node",
    "test:jest": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:node": "node scripts/run-node-tests.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zylos-ai/zylos-core.git"
  },
  "keywords": [
    "ai",
    "agent",
    "claude",
    "autonomous"
  ],
  "author": "Zylos AI",
  "license": "MIT",
  "engines": {
    "node": ">=20.20.0"
  },
  "dependencies": {
    "better-sqlite3": "12.6.2",
    "dotenv": "^16.4.7",
    "js-yaml": "^4.3.1",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "jest": "^30.3.0",
    "pm2": "7.0.4"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": {
        ".": "^3.15.1",
        "argparse": "^2.0.1"
      }
    }
  }
}
